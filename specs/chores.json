{
  "id": "chores",
  "name": "Chore chart",
  "description": "A kid's chore chart with stars for finished chores.",
  "theme": { "accent": "#f08c00" },
  "data": {
    "chores": {
      "type": "list",
      "fields": { "id": "string", "name": "string", "done": "boolean" },
      "default": [
        { "id": "c1", "name": "Make the bed", "done": false },
        { "id": "c2", "name": "Feed the cat", "done": false },
        { "id": "c3", "name": "Pack school bag", "done": false }
      ]
    },
    "stars": { "type": "number", "default": 0 }
  },
  "state": { "draft": "" },
  "screens": {
    "main": {
      "title": "Chores",
      "body": {
        "type": "column",
        "style": { "gap": 16 },
        "children": [
          {
            "type": "card",
            "children": [
              {
                "type": "row",
                "style": { "align": "center", "gap": 12 },
                "children": [
                  {
                    "type": "row",
                    "style": { "gap": 2 },
                    "children": [
                      {
                        "type": "shape", "each": "range(5)", "as": "i", "path": "@star",
                        "fill": "{{i < stars % 5 || (stars > 0 && stars % 5 == 0) ? 'accent' : 'border'}}",
                        "style": { "width": 28, "height": 28 }
                      }
                    ]
                  },
                  { "type": "text", "variant": "caption", "value": "{{plural(stars, 'star')}} earned", "style": { "grow": 1, "textAlign": "right" } }
                ]
              },
              { "type": "progress", "value": "{{count(chores, 'done') / max(1, len(chores))}}" },
              { "type": "text", "variant": "caption", "value": "{{count(chores, 'done')}} of {{len(chores)}} done today" }
            ]
          },
          {
            "type": "column",
            "style": { "gap": 8 },
            "children": [
              {
                "type": "row",
                "each": "chores",
                "as": "chore",
                "style": { "align": "center", "gap": 12, "padding": 12, "radius": 14, "background": "{{chore.done ? 'surface' : 'background'}}", "borderWidth": 1, "borderColor": "border", "transition": 200 },
                "onTap": [
                  { "toggle": "chore.done" },
                  { "set": "stars", "to": "chore.done ? stars + 1 : max(0, stars - 1)" }
                ],
                "children": [
                  { "type": "check", "checked": "{{chore.done}}" },
                  { "type": "text", "value": "{{chore.name}}", "style": { "grow": 1, "color": "{{chore.done ? 'muted' : 'text'}}" } },
                  { "type": "shape", "path": "@close", "fill": "muted", "style": { "width": 18, "height": 18 }, "onTap": { "remove": "chore" } }
                ]
              },
              { "type": "text", "if": "len(chores) == 0", "variant": "callout", "value": "No chores yet. Add one below.", "style": { "color": "muted" } }
            ]
          },
          {
            "type": "row",
            "style": { "gap": 8, "align": "center", "transition": 200 },
            "children": [
              { "type": "textfield", "placeholder": "New chore", "bind": "draft", "onSubmit": { "if": "trim(draft) != ''", "then": [{ "push": "chores", "value": { "id": "uid()", "name": "trim(draft)", "done": "false" } }, { "set": "draft", "to": "''" }] } },
              { "type": "button", "label": "Add", "onTap": { "if": "trim(draft) != ''", "then": [{ "push": "chores", "value": { "id": "uid()", "name": "trim(draft)", "done": "false" } }, { "set": "draft", "to": "''" }] } }
            ]
          },
          { "type": "button", "variant": "plain", "label": "Start a new day", "style": { "alignSelf": "center", "transition": 200 }, "onTap": { "set": "chores", "to": "map(chores, c => {id: c.id, name: c.name, done: false})" } }
        ]
      }
    }
  }
}
