{
  "id": "showcase",
  "name": "Showcase",
  "description": "Every primitive in one place: a parity check for hosts.",
  "data": {
    "notes": {
      "type": "list",
      "fields": {
        "id": "string",
        "text": "string"
      },
      "default": []
    }
  },
  "state": {
    "draft": "",
    "picked": "star",
    "palette": [
      "#3b6ef6",
      "#f08c00",
      "#2f9e6a",
      "#e5484d",
      "#8e4ec6",
      "#12a594",
      "#d6409f",
      "#5b5bd6"
    ],
    "shapes": [
      "star",
      "heart",
      "check",
      "plus",
      "minus",
      "circle",
      "ring",
      "square",
      "rounded",
      "close",
      "chevronLeft",
      "chevronRight",
      "trash",
      "bell",
      "drop",
      "pill",
      "clock",
      "calendar",
      "flame",
      "leaf",
      "sparkle",
      "home",
      "edit"
    ],
    "moved": false
  },
  "screens": {
    "main": {
      "title": "Showcase",
      "body": {
        "type": "column",
        "style": {
          "gap": 20
        },
        "children": [
          {
            "type": "text",
            "variant": "headline",
            "value": "Image"
          },
          {
            "type": "image",
            "src": "data:image/png;base64,",
            "style": {
              "radius": 16
            }
          },
          {
            "type": "text",
            "variant": "headline",
            "value": "Horizontal scroll"
          },
          {
            "type": "hscroll",
            "style": {
              "height": 84,
              "gap": 10
            },
            "children": [
              {
                "type": "column",
                "each": "palette",
                "as": "c",
                "style": {
                  "width": 120,
                  "height": 84,
                  "radius": 14,
                  "background": "{{c}}",
                  "padding": 12,
                  "justify": "end"
                },
                "children": [
                  {
                    "type": "text",
                    "variant": "caption",
                    "value": "{{c}}",
                    "style": {
                      "color": "#ffffff"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "variant": "headline",
            "value": "Shapes: {{picked}}"
          },
          {
            "type": "row",
            "style": {
              "gap": 8
            },
            "children": [
              {
                "type": "overlay",
                "each": "slice(shapes, 0, 8)",
                "as": "s",
                "style": {
                  "width": 36,
                  "height": 36,
                  "radius": 10,
                  "background": "{{s == picked ? 'accent' : 'surface'}}"
                },
                "onTap": {
                  "set": "picked",
                  "to": "s"
                },
                "children": [
                  {
                    "type": "shape",
                    "path": "{{'@' + s}}",
                    "fill": "{{s == picked ? 'onAccent' : 'text'}}",
                    "style": {
                      "width": 20,
                      "height": 20
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "style": {
              "gap": 8
            },
            "children": [
              {
                "type": "overlay",
                "each": "slice(shapes, 8, 16)",
                "as": "s",
                "style": {
                  "width": 36,
                  "height": 36,
                  "radius": 10,
                  "background": "{{s == picked ? 'accent' : 'surface'}}"
                },
                "onTap": {
                  "set": "picked",
                  "to": "s"
                },
                "children": [
                  {
                    "type": "shape",
                    "path": "{{'@' + s}}",
                    "fill": "{{s == picked ? 'onAccent' : 'text'}}",
                    "style": {
                      "width": 20,
                      "height": 20
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "style": {
              "gap": 8
            },
            "children": [
              {
                "type": "overlay",
                "each": "slice(shapes, 16, 24)",
                "as": "s",
                "style": {
                  "width": 36,
                  "height": 36,
                  "radius": 10,
                  "background": "{{s == picked ? 'accent' : 'surface'}}"
                },
                "onTap": {
                  "set": "picked",
                  "to": "s"
                },
                "children": [
                  {
                    "type": "shape",
                    "path": "{{'@' + s}}",
                    "fill": "{{s == picked ? 'onAccent' : 'text'}}",
                    "style": {
                      "width": 20,
                      "height": 20
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "variant": "headline",
            "value": "Motion"
          },
          {
            "type": "row",
            "style": {
              "height": 52,
              "padding": 6,
              "radius": 26,
              "background": "surface",
              "justify": "{{moved ? 'end' : 'start'}}"
            },
            "onTap": {
              "toggle": "moved"
            },
            "children": [
              {
                "type": "overlay",
                "style": {
                  "width": "{{moved ? 120 : 40}}",
                  "height": 40,
                  "radius": 20,
                  "background": "{{moved ? 'success' : 'accent'}}",
                  "transition": {
                    "duration": 450,
                    "easing": "spring"
                  }
                },
                "children": [
                  {
                    "type": "text",
                    "variant": "caption",
                    "value": "{{moved ? 'Spring!' : ''}}",
                    "style": {
                      "color": "onAccent",
                      "fontWeight": 600
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "progress",
            "value": "{{moved ? 0.8 : 0.2}}"
          },
          {
            "type": "text",
            "variant": "headline",
            "value": "Text"
          },
          {
            "type": "row",
            "style": {
              "gap": 8
            },
            "children": [
              {
                "type": "text",
                "variant": "caption",
                "value": "Chip",
                "style": {
                  "paddingX": 10,
                  "paddingY": 4,
                  "radius": 10,
                  "background": "surface",
                  "color": "text"
                }
              },
              {
                "type": "text",
                "variant": "caption",
                "value": "Accent chip",
                "style": {
                  "paddingX": 10,
                  "paddingY": 4,
                  "radius": 10,
                  "background": "accent",
                  "color": "onAccent"
                }
              },
              {
                "type": "text",
                "variant": "caption",
                "value": "Bordered",
                "style": {
                  "paddingX": 10,
                  "paddingY": 4,
                  "radius": 10,
                  "borderWidth": 1,
                  "borderColor": "border"
                }
              }
            ]
          },
          {
            "type": "text",
            "value": "A long paragraph wraps across several lines, measured by the host with its own system font, so line breaks match what it draws exactly."
          },
          {
            "type": "divider"
          },
          {
            "type": "text",
            "variant": "headline",
            "value": "Notes (keyboard test)"
          },
          {
            "type": "text",
            "each": "notes",
            "as": "n",
            "value": "• {{n.text}}"
          },
          {
            "type": "row",
            "style": {
              "gap": 8
            },
            "children": [
              {
                "type": "textfield",
                "placeholder": "Write a note",
                "bind": "draft",
                "onSubmit": {
                  "if": "trim(draft) != ''",
                  "then": [
                    {
                      "push": "notes",
                      "value": {
                        "id": "uid()",
                        "text": "trim(draft)"
                      }
                    },
                    {
                      "set": "draft",
                      "to": "''"
                    }
                  ]
                }
              },
              {
                "type": "button",
                "label": "Clear",
                "variant": "secondary",
                "onTap": {
                  "set": "notes",
                  "to": "[]"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
